# Copy to `.env` in the repo root (gitignored). Loaded automatically in debug builds.
# HTTPS origins only; no trailing path on DA base or issuer URLs.

# Tenant DA / MCP backend origin (e.g. https://your-tenant.your-mcp-host)
XFALCON_DA_BASE_URL=

# Casdoor issuer URL (e.g. https://auth.your-company.com)
XFALCON_CASDOOR_ISSUER=

# Desktop OAuth public client id (from tenant connector config / Casdoor app)
XFALCON_CASDOOR_CLIENT_ID=

# Casdoor organization name (usually the tenant slug)
XFALCON_CASDOOR_ORGANIZATION=

# OAuth loopback port (default 19847). Register this redirect URL on the Casdoor app:
# http://127.0.0.1:19847/callback
# XFALCON_OAUTH_LOOPBACK_PORT=19847

# MCP sign-in fallback client id (optional). Only used when the shared grant key
# below is NOT configured and the authorization server refuses dynamic client
# registration -- which every Iseyon tenant does. Register its redirect URI as
# the MCP loopback, which is one above the login one:
#   http://127.0.0.1:19848/callback
# Without this the sign-in sheet asks every user to paste a client id.
# XFALCON_MCP_CLIENT_ID=

# Its secret, when the tenant issues a confidential client rather than a public
# one. Read only alongside the id above -- on its own it belongs to no client
# and is ignored. Leave unset for a public client.
#
# In a distributed build this is bundled in resources/tenant-config.json and is
# therefore extractable from any copy: it is a tenant-wide shared credential,
# not a per-device one. Prefer a public client where the authorization server
# allows it. Set it in CI as the MCP_CLIENT_SECRET environment secret, never as
# a workflow_dispatch input -- inputs are recorded in the run.
# XFALCON_MCP_CLIENT_SECRET=

# --- Shared MCP OAuth grant (optional) ---------------------------------
#
# Set this to the SAME value xfalcon-web uses for PROVIDER_KEYS_ENCRYPTION_KEY
# and an OAuth MCP server signed in on either product is signed in on both:
# the grant lives in DA (`mcp_oauth_grants`) as AES-256-GCM ciphertext under
# this key, so a client without it cannot read or write that row.
#
# Leave it unset -- the default -- and each device keeps its own sign-in in the
# OS keychain instead. Nothing else changes.
#
# 32 bytes, as base64:<value>, bare base64, or 64 hex characters. Treat it as a
# workspace-wide secret: it decrypts every stored MCP grant in the tenant, so
# configure it only where the machine is managed.
# XFALCON_MCP_GRANT_KEK=

# The MCP sign-in listens on XFALCON_OAUTH_LOOPBACK_PORT + 1 (default 19848).
# Register that redirect URL too on any server that checks redirect URIs
# literally: http://127.0.0.1:19848/callback
