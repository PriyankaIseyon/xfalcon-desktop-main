  "patches": [
    {
      "reason": "Bound the loaded-image decode and paint wait when a host leaves image decoding or offscreen animation frames pending.",
      "before": "r.decode().then((function(){requestAnimationFrame((function(){return e(r)}))}))",
      "after": "var a=setTimeout((function(){return e(r)}),1000);r.decode().then((function(){requestAnimationFrame((function(){clearTimeout(a);return e(r)}))}),(function(){clearTimeout(a);return e(r)}))"
    }
  ]
}
